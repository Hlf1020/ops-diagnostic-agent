# ===== LLM（OpenAI-compatible；留空则进入离线降级模式）=====
# DeepSeek: https://api.deepseek.com/v1  model=deepseek-chat
# Qwen:     https://dashscope.aliyuncs.com/compatible-mode/v1  model=qwen2.5-72b-instruct
LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_S=45
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
# 成本核算（美元 / 百万 token），按实际供应商价格修改
LLM_INPUT_PRICE_PER_MTOK=0.27
LLM_OUTPUT_PRICE_PER_MTOK=1.10
LLM_CRITIC_ENABLED=true

# ===== 存储后端（留空 = 进程内内存实现，便于零依赖演示）=====
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=
# QDRANT_URL=http://localhost:6333
QDRANT_URL=
QDRANT_PATH=
QDRANT_COLLECTION=ops_cases
# auto: 配置了 REDIS_URL/QDRANT_URL 就用真实后端，否则内存
SESSION_BACKEND=auto
LONG_TERM_BACKEND=auto
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_DB=data/checkpoints.sqlite

# ===== 运行参数 =====
MOCK_NOW=2026-10-20T22:00:00+08:00
TIME_WINDOW_PAD_MINUTES=30
EXPLICIT_WINDOW_MINUTES=60
DEFAULT_WINDOW_HOURS=2
MAX_RETRIES=2
MEMORY_TOP_K=3
MEMORY_TTL_DAYS=90
CONTEXT_TURN_LIMIT=4
TRACE_DIR=data/traces
TRACING_ENABLED=true
KB_PATH=data/kb/docs.jsonl
TOOL_MAX_OUTPUT_CHARS=24000
TOOL_TIMEOUT_S=8
APPROVAL_TTL_MINUTES=30
AUDIT_PATH=data/audit/approvals.jsonl

# ===== 故障注入（仅 mock 后端，用于演示降级/超时）=====
# 逗号分隔，例如 query_metrics,get_changes
MOCK_FAIL_TOOLS=
# 逗号分隔 name:delay_ms，例如 query_metrics:9000
MOCK_DELAY=

# ===== 评测 =====
EVAL_OUTPUT_DIR=data/eval